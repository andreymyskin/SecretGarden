  "equipment": [
    {
      "id": "equipment-1",
      "title": "Осветитель Aputure Amaran 300c",
      "description": "Полноцветный светодиодный светильник с точечным источником мощностью 300 Вт, сочетающий в себе полноцветное управление RGBWW, универсальность оптического и мягкого света, встроенные элементы управления и высококачественный световой поток.",
      "image": "/images/equipment/item-01.webp"
    },
    {
      "id": "equipment-2",
      "title": "Осветитель Godox SL100BI",
      "description": "Компактный и очень мощный светодиодный осветитель, выдающий световой поток с регулируемой цветовой температурой 2800K~6500K (в широком диапазоне от «теплого» до «холодного» белого цвета) и регулируемой яркостью от 0 до 100%.",
      "image": "/images/equipment/item-02.webp"
    },
    {
      "id": "equipment-3",
      "title": "Октобоксы Triopo 90 см",
      "description": "Октобоксы Triopo позволяют получить мягкий светотеневой рисунок без резких переходов и теней на снимаемом объекте или фоне. В студии доступны 2 октобокса с двумя тканевыми рассеивателями + Соты, которые ограничивают световой поток и делают его более узким, оставляя только параллельные лучи, позволяя усилить контраст в снимке.",
      "image": "/images/equipment/item-03.webp"
    },
    {
      "id": "equipment-4",
      "title": "Генератор тумана Falcon Eyes F-1200R",
      "description": "Устройство для создания дымовых спецэффектов мощностью 1200 Вт. Даст возможность наиболее реалистичным образом создать ощущение тумана на снимках. Управление производится беспроводным пультом дистанционного управления.",
      "image": "/images/equipment/item-04.webp"
    },
    {
      "id": "equipment-5",
      "title": "Генератор снега Falcon Eyes SM-1200",
      "description": "Генератор снега создает эффект настоящего снегопада, что позволяет применять его в качестве спецэффекта зимнего времени года. Размер хлопьев регулируется проводным пультом управления.",
      "image": "/images/equipment/item-05.webp"
    },
    {
      "id": "equipment-6",
      "title": "Портативная колонка Fiero Dream FR600",
      "description": "Портативная Bluetooth колонка мощностью 60 Вт поможет вам создать необходимую атмосферу во время фотосессии.",
      "image": "/images/equipment/item-06.webp"
    },
    {
      "id": "equipment-7",
      "title": "Стремянка",
