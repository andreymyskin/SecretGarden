# Пароль администратора по умолчанию. После смены пароля в админ-панели
# действует пароль из data/auth.json, а эта переменная используется только
# как запасной вариант (если удалить data/auth.json).
ADMIN_PASSWORD=secretgarden
# Секрет для подписи cookie сессии — замените на длинную случайную строку.
ADMIN_SECRET=change-me-to-a-long-random-string

# Публичный адрес сайта — для canonical-ссылок, Open Graph, sitemap.xml и robots.txt.
NEXT_PUBLIC_SITE_URL=https://secretgarden62.ru
# Коды подтверждения прав на сайт (необязательно): Яндекс Вебмастер и Google Search Console.
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
