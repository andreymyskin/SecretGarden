# Шаблон .htaccess для виртуального хостинга Beget.
# Файл кладётся в каталог САЙТА (например ~/secretgarden62.ru/), рядом с public_html.
# Замените USERNAME на логин хостинга (см. пример команд в DEPLOY.md — они подставят пути сами).

PassengerNodejs /home/u/USERNAME/.local/bin/node
PassengerAppRoot /home/u/USERNAME/secretgarden62.ru/app
PassengerAppType node
PassengerStartupFile server.js
PassengerAppEnv production

# www.secretgarden62.ru -> secretgarden62.ru (единое главное зеркало для поисковиков)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
